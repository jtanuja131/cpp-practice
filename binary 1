#include <iostream>
using namespace std;

class Number
{
    int n;

public:
    Number(int x)
    {
        n = x;
    }

    Number operator+(Number obj)
    {
        Number temp(0);
        temp.n = n + obj.n;
        return temp;
    }

    void display()
    {
        cout << "Sum = " << n;
    }
};

int main()
{
    int x, y;

    cout << "Enter first number: ";
    cin >> x;

    cout << "Enter second number: ";
    cin >> y;

    Number a(x), b(y);

    Number c = a + b;

    c.display();

    return 0;
}
